Improper use of '--format' option.


RUN: ! %target_nm_cmd --format= > %t.stdout 2> %t.stderr
RUN: test -s %t.stderr
RUN: head -n 1 < %t.stderr | grep -qe '^: invalid output format$'
RUN: grep -qe '^Usage: nvptx-none-nm ' < %t.stderr
RUN: test -f %t.stdout
RUN: ! test -s %t.stdout

RUN: ! %target_nm_cmd -f '' > %t.stdout 2> %t.stderr
RUN: test -s %t.stderr
RUN: head -n 1 < %t.stderr | grep -qe '^: invalid output format$'
RUN: grep -qe '^Usage: nvptx-none-nm ' < %t.stderr
RUN: test -f %t.stdout
RUN: ! test -s %t.stdout


RUN: ! %target_nm_cmd --format=123 > %t.stdout 2> %t.stderr
RUN: test -s %t.stderr
RUN: head -n 1 < %t.stderr | grep -qe '^123: invalid output format$'
RUN: grep -qe '^Usage: nvptx-none-nm ' < %t.stderr
RUN: test -f %t.stdout
RUN: ! test -s %t.stdout

RUN: ! %target_nm_cmd -f 123 > %t.stdout 2> %t.stderr
RUN: test -s %t.stderr
RUN: head -n 1 < %t.stderr | grep -qe '^123: invalid output format$'
RUN: grep -qe '^Usage: nvptx-none-nm ' < %t.stderr
RUN: test -f %t.stdout
RUN: ! test -s %t.stdout
